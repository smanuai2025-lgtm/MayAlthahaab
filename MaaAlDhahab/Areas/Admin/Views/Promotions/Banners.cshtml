@model List<Banner>
@{
    ViewData["Title"] = "البانرات التسويقية";
}

<div class="flex justify-between items-center mb-6">
    <p class="text-gray-400 text-sm">@Model.Count بانر مسجل</p>
    <a href="/admin/promotions/createbanner" class="btn-gold px-5 py-2 rounded-xl text-sm flex items-center gap-2">
        <i class="fas fa-plus"></i> إضافة بانر
    </a>
</div>

<div class="grid md:grid-cols-2 gap-4">
    @foreach (var banner in Model)
    {
        <div class="admin-card flex gap-4 items-start">
            <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                    <span class="badge badge-gold">@banner.Position</span>
                    <span class="badge @(banner.IsActive ? "badge-success" : "badge-danger")">@(banner.IsActive ? "نشط" : "متوقف")</span>
                </div>
                <h3 class="text-white font-bold">@banner.TitleAr</h3>
                <p class="text-gray-400 text-sm mt-1">@banner.SubtitleAr</p>
                @if (!string.IsNullOrEmpty(banner.LinkUrl))
                {
                    <p class="text-gold text-xs mt-2" dir="ltr">@banner.LinkUrl</p>
                }
            </div>
        </div>
    }
</div>
