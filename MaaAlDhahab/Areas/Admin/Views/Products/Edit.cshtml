@model Product
@{
    ViewData["Title"] = "تعديل: " + Model.NameAr;
}
@* Reuse Create form with populated values *@
<div class="max-w-3xl">
    <form method="post" asp-action="Edit" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="admin-card">
            <h2 class="text-white font-bold mb-4"><i class="fas fa-info-circle text-gold ml-2"></i>المعلومات الأساسية</h2>
            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="text-gray-400 text-sm block mb-1">الاسم بالعربية *</label>
                    <input asp-for="NameAr" class="w-full" />
                </div>
                <div>
                    <label class="text-gray-400 text-sm block mb-1">الاسم بالإنجليزية</label>
                    <input asp-for="NameEn" dir="ltr" class="w-full" />
                </div>
                <div class="md:col-span-2">
                    <label class="text-gray-400 text-sm block mb-1">الوصف بالعربية</label>
                    <textarea asp-for="DescriptionAr" rows="3" class="w-full"></textarea>
                </div>
                <div class="md:col-span-2">
                    <label class="text-gray-400 text-sm block mb-1">الوصف بالإنجليزية</label>
                    <textarea asp-for="DescriptionEn" rows="3" dir="ltr" class="w-full"></textarea>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <h2 class="text-white font-bold mb-4"><i class="fas fa-tags text-gold ml-2"></i>التصنيف والسعر</h2>
            <div class="grid md:grid-cols-3 gap-4">
                <div>
                    <label class="text-gray-400 text-sm block mb-1">الفئة</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full"></select>
                </div>
                <div>
                    <label class="text-gray-400 text-sm block mb-1">السعر (KD)</label>
                    <input asp-for="PriceKWD" type="number" step="0.001" dir="ltr" class="w-full" />
                </div>
                <div>
                    <label class="text-gray-400 text-sm block mb-1">السعر الأصلي</label>
                    <input asp-for="OriginalPriceKWD" type="number" step="0.001" dir="ltr" class="w-full" />
                </div>
                <div>
                    <label class="text-gray-400 text-sm block mb-1">الجنس</label>
                    <select asp-for="Gender" class="w-full">
                        <option value="Female">نسائي</option>
                        <option value="Male">رجالي</option>
                        <option value="Unisex">يونيسكس</option>
                        <option value="Kids">أطفال</option>
                    </select>
                </div>
                <div>
                    <label class="text-gray-400 text-sm block mb-1">التركيز</label>
                    <select asp-for="Concentration" class="w-full">
                        <option value="EDP">EDP</option>
                        <option value="EDT">EDT</option>
                        <option value="Parfum">Parfum</option>
                        <option value="Bukhoor">بخور</option>
                    </select>
                </div>
                <div>
                    <label class="text-gray-400 text-sm block mb-1">المخزون</label>
                    <input asp-for="StockQuantity" type="number" dir="ltr" class="w-full" />
                </div>
            </div>
        </div>

        <div class="admin-card">
            <label class="text-gray-400 text-sm block mb-1">رابط الصورة</label>
            <input asp-for="ImageUrl" dir="ltr" class="w-full" />
        </div>

        <div class="admin-card">
            <label class="text-gray-400 text-sm block mb-1">نوتات العطر (JSON)</label>
            <textarea asp-for="ScentNotesJson" rows="4" dir="ltr" class="w-full font-mono text-sm"></textarea>
        </div>

        <div class="admin-card">
            <label class="text-gray-400 text-sm block mb-1">الأحجام (JSON)</label>
            <textarea asp-for="SizesJson" rows="3" dir="ltr" class="w-full font-mono text-sm"></textarea>
        </div>

        <div class="admin-card">
            <div class="grid grid-cols-4 gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsFeatured" type="checkbox" class="w-5 h-5" />
                    <span class="text-gray-300 text-sm">مميز</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsNewArrival" type="checkbox" class="w-5 h-5" />
                    <span class="text-gray-300 text-sm">جديد</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsBestSeller" type="checkbox" class="w-5 h-5" />
                    <span class="text-gray-300 text-sm">الأكثر مبيعاً</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox" class="w-5 h-5" />
                    <span class="text-gray-300 text-sm">نشط</span>
                </label>
            </div>
        </div>

        <div class="flex gap-4">
            <button type="submit" class="btn-gold px-8 py-3 rounded-xl font-bold">
                <i class="fas fa-save ml-2"></i> حفظ التغييرات
            </button>
            <a href="/admin/products" class="px-8 py-3 rounded-xl border border-luxury-border text-gray-400 hover:text-gold transition-all">
                إلغاء
            </a>
        </div>
    </form>
</div>
