@model HomeViewModel
@{
    ViewData["Title"] = "الرئيسية";
}

<!-- ═══════════════════════════════════════ HERO SECTION ═══════════════════════════════════════ -->
<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
    <!-- Background: Luxury dark with gold particle effects -->
    <div class="absolute inset-0 bg-luxury-black">
        <!-- Animated background gradient -->
        <div class="absolute inset-0 bg-gradient-to-br from-black via-luxury-card to-luxury-section opacity-90"></div>
        <!-- Gold radial glow -->
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gold opacity-5 rounded-full blur-3xl"></div>
        <div class="absolute top-1/4 right-1/4 w-64 h-64 bg-gold opacity-5 rounded-full blur-3xl"></div>
    </div>

    <!-- Particles Canvas -->
    <canvas id="particles-canvas" class="absolute inset-0 pointer-events-none"></canvas>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 py-20 w-full">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Text Content -->
            <div class="text-center lg:text-right">
                <!-- Eyebrow -->
                <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 border border-gold border-opacity-30 rounded-full text-xs text-gold tracking-widest uppercase">
                    <span class="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
                    <span class="ar-text">مجموعة 2025 - الحصرية</span>
                    <span class="en-text hidden">2025 Exclusive Collection</span>
                </div>

                <!-- Main Heading -->
                <h1 class="text-5xl md:text-6xl lg:text-7xl font-black leading-tight mb-4">
                    <span class="block text-white ar-text">عطرك يعبّر</span>
                    <span class="block gold-gradient ar-text">عن شخصيتك</span>
                    <span class="block text-white en-text hidden text-4xl">Your Scent</span>
                    <span class="block gold-gradient en-text hidden text-4xl">Defines You</span>
                </h1>

                <!-- Subtitle -->
                <p class="text-gray-300 text-lg md:text-xl leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0 ar-text">
                    مع عطور ماء الذهب الكويتية، ستكون دائماً مميزاً. إبداع عبدالرحمن أبو الذهب — أسطورة العطور المصرية في قلب الكويت.
                </p>
                <p class="text-gray-300 text-lg leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0 en-text hidden">
                    With Maa Al Dhahab Kuwait perfumes, you're always unique. The artistry of Abdul Rahman Abu Al Dhahab — legendary Egyptian perfumer in the heart of Kuwait.
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="/Shop" class="btn-gold px-10 py-4 rounded-xl text-lg font-bold tracking-wider flex items-center justify-center gap-2">
                        <span class="ar-text">تسوق الآن</span>
                        <span class="en-text hidden">Shop Now</span>
                        <i class="fas fa-arrow-left ar-text"></i>
                        <i class="fas fa-arrow-right en-text hidden"></i>
                    </a>
                    <a href="/Home/About" class="btn-outline-gold px-10 py-4 rounded-xl text-lg font-bold tracking-wider flex items-center justify-center gap-2">
                        <span class="ar-text">قصتنا</span>
                        <span class="en-text hidden">Our Story</span>
                        <i class="fas fa-play text-xs"></i>
                    </a>
                </div>

                <!-- Stats -->
                <div class="flex gap-8 mt-12 justify-center lg:justify-start">
                    <div class="text-center">
                        <div class="text-3xl font-black gold-text">+500</div>
                        <div class="text-gray-500 text-xs mt-1 ar-text">عميل سعيد</div>
                        <div class="text-gray-500 text-xs mt-1 en-text hidden">Happy Clients</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-black gold-text">12+</div>
                        <div class="text-gray-500 text-xs mt-1 ar-text">عطر فريد</div>
                        <div class="text-gray-500 text-xs mt-1 en-text hidden">Unique Scents</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-black gold-text">4</div>
                        <div class="text-gray-500 text-xs mt-1 ar-text">فروع الكويت</div>
                        <div class="text-gray-500 text-xs mt-1 en-text hidden">KW Branches</div>
                    </div>
                </div>
            </div>

            <!-- Hero Visual: Floating Perfume Bottle -->
            <div class="hidden lg:flex items-center justify-center relative">
                <div class="relative animate-float">
                    <!-- Perfume bottle SVG placeholder -->
                    <div class="w-72 h-96 relative">
                        <svg viewBox="0 0 200 300" class="w-full h-full drop-shadow-2xl" xmlns="http://www.w3.org/2000/svg">
                            <!-- Cap -->
                            <rect x="75" y="10" width="50" height="30" rx="8" fill="url(#goldGrad)" />
                            <!-- Neck -->
                            <rect x="82" y="38" width="36" height="20" rx="4" fill="#C9A227"/>
                            <!-- Bottle body -->
                            <rect x="50" y="58" width="100" height="160" rx="16" fill="url(#bottleGrad)"/>
                            <!-- Glass shine -->
                            <rect x="60" y="70" width="8" height="100" rx="4" fill="white" opacity="0.15"/>
                            <!-- Gold label -->
                            <rect x="60" y="110" width="80" height="60" rx="6" fill="url(#labelGrad)" opacity="0.9"/>
                            <!-- Arabic text on label -->
                            <text x="100" y="135" text-anchor="middle" fill="#0A0A0A" font-size="12" font-weight="bold" font-family="Cairo">ماء الذهب</text>
                            <text x="100" y="155" text-anchor="middle" fill="#0A0A0A" font-size="9" font-family="Arial">MAA AL DHAHAB</text>
                            <!-- Bottom -->
                            <rect x="50" y="215" width="100" height="15" rx="0 0 16 16" fill="#A88B00" opacity="0.6"/>

                            <!-- Gradients -->
                            <defs>
                                <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#F5E6B2"/>
                                    <stop offset="50%" style="stop-color:#D4AF37"/>
                                    <stop offset="100%" style="stop-color:#8B6914"/>
                                </linearGradient>
                                <linearGradient id="bottleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:0.9"/>
                                    <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:0.95"/>
                                </linearGradient>
                                <linearGradient id="labelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#F5E6B2"/>
                                    <stop offset="50%" style="stop-color:#D4AF37"/>
                                    <stop offset="100%" style="stop-color:#C9A227"/>
                                </linearGradient>
                            </defs>
                        </svg>

                        <!-- Glow effect -->
                        <div class="absolute inset-0 bg-gold opacity-10 blur-3xl rounded-full -z-10"></div>

                        <!-- Floating notes -->
                        <div class="absolute top-0 right-0 w-16 h-16 bg-luxury-card border border-gold-dark rounded-xl p-2 shadow-xl" style="animation: float 2.5s ease-in-out infinite; animation-delay: 0.5s;">
                            <div class="text-xs text-gold font-bold text-center">ورد</div>
                            <div class="text-xs text-gray-400 text-center">Rose</div>
                        </div>
                        <div class="absolute bottom-20 left-0 w-16 h-16 bg-luxury-card border border-gold-dark rounded-xl p-2 shadow-xl" style="animation: float 3.5s ease-in-out infinite; animation-delay: 1s;">
                            <div class="text-xs text-gold font-bold text-center">عود</div>
                            <div class="text-xs text-gray-400 text-center">Oud</div>
                        </div>
                        <div class="absolute top-1/3 left-0 w-16 h-16 bg-luxury-card border border-gold-dark rounded-xl p-2 shadow-xl" style="animation: float 3s ease-in-out infinite; animation-delay: 1.5s;">
                            <div class="text-xs text-gold font-bold text-center">مسك</div>
                            <div class="text-xs text-gray-400 text-center">Musk</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-gray-500 animate-bounce">
        <span class="text-xs tracking-widest ar-text">اكتشف</span>
        <i class="fas fa-chevron-down text-gold"></i>
    </div>
</section>

<!-- ═══════════════════════════════════════ PROMO BANNER ═══════════════════════════════════════ -->
<section class="bg-gradient-to-r from-gold-dark via-gold to-gold-light py-4">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-luxury-black">
        <div class="flex items-center gap-3">
            <i class="fas fa-fire text-2xl"></i>
            <div>
                <p class="font-black text-lg ar-text">عرض محدود! خصم 20% على جميع العطور</p>
                <p class="font-black text-lg en-text hidden">Limited offer! 20% off all perfumes</p>
                <p class="text-xs font-medium ar-text">استخدم كود: WELCOME20</p>
                <p class="text-xs font-medium en-text hidden">Use code: WELCOME20</p>
            </div>
        </div>
        <a href="/Shop" class="bg-luxury-black text-gold px-6 py-3 rounded-xl font-bold text-sm hover:bg-gray-900 transition-colors whitespace-nowrap">
            <span class="ar-text">احصل على الخصم ←</span>
            <span class="en-text hidden">Claim Discount →</span>
        </a>
    </div>
</section>

<!-- ═══════════════════════════════════════ CATEGORIES ═══════════════════════════════════════ -->
<section class="py-20 bg-luxury-black">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
            <p class="text-gold text-sm font-medium tracking-widest uppercase mb-2 ar-text">استكشف المجموعات</p>
            <p class="text-gold text-sm font-medium tracking-widest uppercase mb-2 en-text hidden">Explore Collections</p>
            <h2 class="text-4xl md:text-5xl font-black text-white ar-text">تصفح حسب الفئة</h2>
            <h2 class="text-4xl md:text-5xl font-black text-white en-text hidden">Browse by Category</h2>
            <div class="w-24 h-0.5 bg-gold mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            @foreach (var category in Model.Categories)
            {
                <a href="/Shop?categoryId=@category.Id" class="luxury-card rounded-2xl p-6 text-center group cursor-pointer">
                    <div class="w-16 h-16 mx-auto mb-4 bg-luxury-section border border-luxury-border rounded-full flex items-center justify-center group-hover:border-gold transition-all">
                        <i class="@(category.IconClass ?? "fas fa-spray-can") text-2xl text-gold"></i>
                    </div>
                    <p class="text-white font-bold text-sm ar-text">@category.NameAr</p>
                    <p class="text-white font-bold text-sm en-text hidden">@category.NameEn</p>
                    <p class="text-gray-500 text-xs mt-1">@category.Products.Count عطر</p>
                </a>
            }
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════ FEATURED PRODUCTS ═══════════════════════════════════════ -->
<section class="py-20 bg-luxury-section">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between mb-12">
            <div>
                <p class="text-gold text-sm font-medium tracking-widest uppercase mb-2 ar-text">الأكثر مبيعاً</p>
                <p class="text-gold text-sm font-medium tracking-widest uppercase mb-2 en-text hidden">Best Sellers</p>
                <h2 class="text-4xl md:text-5xl font-black text-white ar-text">المنتجات المميزة</h2>
                <h2 class="text-4xl md:text-5xl font-black text-white en-text hidden">Featured Products</h2>
            </div>
            <a href="/Shop" class="btn-outline-gold px-6 py-3 rounded-xl text-sm font-bold hidden md:block">
                <span class="ar-text">عرض الكل</span>
                <span class="en-text hidden">View All</span>
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-3 gap-6" id="featured-grid">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="luxury-card rounded-2xl overflow-hidden group">
                    <!-- Image -->
                    <div class="product-img-container relative bg-luxury-section h-56 md:h-64">
                        <img src="@product.ImageUrl" alt="@product.NameAr"
                             class="w-full h-full object-cover"
                             onerror="this.src='/images/product-placeholder.svg'" />

                        <!-- Badges -->
                        <div class="absolute top-3 right-3 flex flex-col gap-1">
                            @if (product.IsBestSeller)
                            {
                                <span class="bg-gold text-black text-xs px-2 py-0.5 rounded-full font-bold ar-text">الأكثر مبيعاً</span>
                            }
                            @if (product.IsNewArrival)
                            {
                                <span class="bg-luxury-black border border-gold text-gold text-xs px-2 py-0.5 rounded-full ar-text">جديد</span>
                            }
                            @if (product.OriginalPriceKWD.HasValue)
                            {
                                var discount = (int)(((product.OriginalPriceKWD.Value - product.PriceKWD) / product.OriginalPriceKWD.Value) * 100);
                                <span class="bg-red-600 text-white text-xs px-2 py-0.5 rounded-full font-bold">-@discount%</span>
                            }
                        </div>

                        <!-- Wishlist button -->
                        <button onclick="toggleWishlist(@product.Id, this)" class="absolute top-3 left-3 w-9 h-9 bg-luxury-black bg-opacity-80 rounded-full flex items-center justify-center hover:bg-gold hover:text-black transition-all">
                            <i class="far fa-heart text-sm"></i>
                        </button>

                        <!-- Quick add overlay -->
                        <div class="absolute inset-0 bg-black bg-opacity-60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <button onclick="quickAddToCart(@product.Id, '@product.NameAr', @product.PriceKWD)" class="btn-gold px-6 py-3 rounded-xl text-sm font-bold">
                                <i class="fas fa-shopping-bag ml-2"></i>
                                <span class="ar-text">أضف للسلة</span>
                                <span class="en-text hidden">Add to Cart</span>
                            </button>
                        </div>
                    </div>

                    <!-- Info -->
                    <div class="p-4">
                        <p class="text-gray-400 text-xs mb-1 ar-text">@(product.Category?.NameAr ?? "")</p>
                        <a href="/Product/Detail/@product.Id">
                            <h3 class="font-bold text-lg text-white group-hover:text-gold transition-colors ar-text leading-tight">@product.NameAr</h3>
                            <h3 class="font-bold text-base text-white group-hover:text-gold transition-colors en-text hidden leading-tight">@product.NameEn</h3>
                        </a>

                        <!-- Rating -->
                        <div class="flex items-center gap-1 mt-1">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <i class="fas fa-star text-xs @(s <= (int)product.Rating ? "text-gold" : "text-gray-600")"></i>
                            }
                            <span class="text-gray-400 text-xs mr-1">(@product.ReviewCount)</span>
                        </div>

                        <!-- Scent type -->
                        @if (!string.IsNullOrEmpty(product.Concentration))
                        {
                            <span class="text-xs text-gray-500 border border-luxury-border rounded px-2 py-0.5 mt-1 inline-block">@product.Concentration</span>
                        }

                        <!-- Price + Add to cart -->
                        <div class="flex items-center justify-between mt-3">
                            <div>
                                <span class="text-xl font-black text-gold">@product.PriceKWD.ToString("F3") KD</span>
                                @if (product.OriginalPriceKWD.HasValue)
                                {
                                    <span class="text-gray-500 text-sm line-through mr-2">@product.OriginalPriceKWD.Value.ToString("F3")</span>
                                }
                            </div>
                            <a href="/Product/Detail/@product.Id" class="w-10 h-10 bg-gold rounded-xl flex items-center justify-center hover:bg-gold-light transition-colors">
                                <i class="fas fa-eye text-black text-sm"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-10">
            <a href="/Shop" class="btn-gold px-12 py-4 rounded-xl text-lg font-bold inline-block">
                <span class="ar-text">تسوق جميع العطور</span>
                <span class="en-text hidden">Shop All Perfumes</span>
            </a>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════ BRAND STORY ═══════════════════════════════════════ -->
<section class="py-24 bg-luxury-black relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-full h-full opacity-5">
        <div class="absolute top-10 right-10 text-gold text-9xl font-black opacity-10 ar-text select-none">ماء</div>
        <div class="absolute bottom-10 left-10 text-gold text-9xl font-black opacity-10 ar-text select-none">الذهب</div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Story Image / Perfumer Illustration -->
            <div class="order-2 lg:order-1 flex justify-center">
                <div class="relative w-80 h-80">
                    <div class="absolute inset-0 bg-gradient-to-br from-gold to-gold-dark rounded-full opacity-10 animate-pulse"></div>
                    <div class="absolute inset-4 luxury-card rounded-full border-2 border-gold border-opacity-30 flex items-center justify-center">
                        <svg viewBox="0 0 200 200" class="w-48 h-48" xmlns="http://www.w3.org/2000/svg">
                            <!-- Perfumer silhouette -->
                            <circle cx="100" cy="70" r="30" fill="#D4AF37" opacity="0.8"/>
                            <path d="M55 180 C55 140 145 140 145 180" fill="#D4AF37" opacity="0.6"/>
                            <!-- Perfume bottle in hand -->
                            <rect x="120" y="100" width="20" height="30" rx="4" fill="#D4AF37" opacity="0.9"/>
                            <rect x="125" y="92" width="10" height="12" rx="2" fill="#D4AF37"/>
                            <!-- Scent lines -->
                            <path d="M140 95 Q155 85 145 70" stroke="#D4AF37" stroke-width="2" fill="none" opacity="0.5" stroke-dasharray="4"/>
                            <path d="M143 90 Q160 78 148 62" stroke="#D4AF37" stroke-width="1.5" fill="none" opacity="0.3" stroke-dasharray="4"/>
                            <!-- Stars/sparkles -->
                            <text x="30" y="50" font-size="20" fill="#D4AF37" opacity="0.7">✦</text>
                            <text x="155" y="40" font-size="14" fill="#D4AF37" opacity="0.5">✦</text>
                            <text x="160" y="130" font-size="16" fill="#D4AF37" opacity="0.4">✦</text>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Story Text -->
            <div class="order-1 lg:order-2">
                <p class="text-gold text-sm font-medium tracking-widest uppercase mb-4 ar-text">قصة العطار</p>
                <p class="text-gold text-sm font-medium tracking-widest uppercase mb-4 en-text hidden">The Perfumer's Story</p>
                <h2 class="text-4xl md:text-5xl font-black text-white mb-6 leading-tight ar-text">
                    عبدالرحمن أبو الذهب<br/>
                    <span class="gold-gradient text-3xl">أسطورة العطور المصرية</span>
                </h2>
                <h2 class="text-4xl md:text-5xl font-black text-white mb-6 leading-tight en-text hidden">
                    Abdul Rahman<br/>Abu Al Dhahab<br/>
                    <span class="gold-gradient text-2xl">The Egyptian Fragrance Legend</span>
                </h2>

                <div class="space-y-4 text-gray-300 leading-relaxed">
                    <p class="ar-text">وُلد شغف عبدالرحمن أبو الذهب بعالم العطور منذ نعومة أظافره في مصر، حيث ورث سرّ تركيب العطور عن أجداده من كبار العطارين. بتمازج الحضارة المصرية الأصيلة والذوق الكويتي الرفيع، أبدع مجموعة "ماء الذهب" التي غدت بصمة لا تُنسى.</p>
                    <p class="ar-text">كل عطر يحمل قصة، وكل قارورة تحوي حلماً. من قلب القاهرة الجوهرة إلى الكويت اللؤلؤة، رحلة عطرية لا تنتهي.</p>
                    <p class="en-text hidden">Born with a passion for fragrance in Egypt, Abdul Rahman Abu Al Dhahab inherited the secrets of perfumery from generations of master perfumers. Blending authentic Egyptian heritage with refined Kuwaiti taste, he created Maa Al Dhahab — an unforgettable signature.</p>
                </div>

                <div class="grid grid-cols-2 gap-4 mt-8">
                    <div class="luxury-card rounded-xl p-4 border border-luxury-border">
                        <i class="fas fa-award text-gold text-2xl mb-2"></i>
                        <p class="text-white font-bold ar-text">+20 سنة خبرة</p>
                        <p class="text-white font-bold en-text hidden">20+ Years</p>
                        <p class="text-gray-400 text-xs ar-text">في صناعة العطور</p>
                        <p class="text-gray-400 text-xs en-text hidden">In Perfumery</p>
                    </div>
                    <div class="luxury-card rounded-xl p-4 border border-luxury-border">
                        <i class="fas fa-flask text-gold text-2xl mb-2"></i>
                        <p class="text-white font-bold ar-text">+100 مكوّن</p>
                        <p class="text-white font-bold en-text hidden">100+ Ingredients</p>
                        <p class="text-gray-400 text-xs ar-text">مختار بعناية فائقة</p>
                        <p class="text-gray-400 text-xs en-text hidden">Carefully Selected</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════ NEW ARRIVALS ═══════════════════════════════════════ -->
@if (Model.NewArrivals.Any())
{
    <section class="py-20 bg-luxury-section">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-12">
                <p class="text-gold text-sm font-medium tracking-widest uppercase mb-2 ar-text">وصل حديثاً</p>
                <p class="text-gold text-sm font-medium tracking-widest uppercase mb-2 en-text hidden">Just Arrived</p>
                <h2 class="text-4xl md:text-5xl font-black text-white ar-text">أحدث الإضافات</h2>
                <h2 class="text-4xl md:text-5xl font-black text-white en-text hidden">New Arrivals</h2>
                <div class="w-24 h-0.5 bg-gold mx-auto mt-4"></div>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var product in Model.NewArrivals)
                {
                    <div class="luxury-card rounded-2xl overflow-hidden group">
                        <div class="product-img-container h-48 relative bg-luxury-black">
                            <img src="@product.ImageUrl" alt="@product.NameAr" class="w-full h-full object-cover"
                                 onerror="this.src='/images/product-placeholder.svg'" />
                            <div class="absolute top-2 right-2">
                                <span class="bg-luxury-black border border-gold text-gold text-xs px-2 py-0.5 rounded-full font-bold ar-text">جديد</span>
                            </div>
                        </div>
                        <div class="p-4">
