<!-- ═══════════════════════════════════════ PERFUME QUIZ MODAL ═══════════════════════════════════════ -->
<div id="quiz-modal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-80 flex items-center justify-center p-4">
    <div class="bg-luxury-card border border-gold border-opacity-30 rounded-2xl max-w-lg w-full p-8 relative">
        <button onclick="closeQuiz()" class="absolute top-4 left-4 text-gray-400 hover:text-white">
            <i class="fas fa-times text-xl"></i>
        </button>

        <h3 class="text-2xl font-black text-white mb-2 ar-text text-center">اكتشف عطرك المثالي</h3>
        <p class="text-gray-400 text-sm text-center mb-6 ar-text">أجب على هذه الأسئلة البسيطة</p>

        <div id="quiz-content">
            <!-- Quiz steps rendered by JS -->
        </div>

        <div class="flex justify-between mt-6">
            <button id="quiz-prev" onclick="quizPrev()" class="btn-outline-gold px-5 py-2 rounded-xl text-sm hidden">
                <span class="ar-text">السابق</span>
            </button>
            <button id="quiz-next" onclick="quizNext()" class="btn-gold px-5 py-2 rounded-xl text-sm mr-auto">
                <span class="ar-text">التالي</span>
            </button>
        </div>

        <!-- Progress -->
        <div class="mt-4">
            <div class="flex gap-1 justify-center">
                @for (int i = 0; i < 5; i++)
                {
                    <div class="quiz-dot w-2 h-2 rounded-full bg-luxury-border transition-all" data-step="@i"></div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Particles ──
    initParticles();

    // ── QUIZ DATA ──
    const quizQuestions = [
        {
            q: "ما هو موسمك المفضل؟",
            options: ["🌸 الربيع - زهور ونسائم", "☀️ الصيف - حار ومنعش", "🍂 الخريف - دافئ وعميق", "❄️ الشتاء - غامض وحالم"]
        },
        {
            q: "ما هو وقتك المفضل لاستخدام العطر؟",
            options: ["🌅 الصباح الباكر", "💼 في العمل", "🌙 السهرات", "🏃 الرياضة والنشاط"]
        },
        {
            q: "ما هو نمط حياتك؟",
            options: ["👑 أنيق رسمي دائماً", "🎨 عصري ومبدع", "🌿 طبيعي وهادئ", "🔥 جريء وجذاب"]
        },
        {
            q: "أي رائحة تفضلها؟",
            options: ["🌹 زهور ورومانسية", "🪵 عود وخشب شرقي", "🍊 حمضيات منعشة", "🌿 مسك وعنبر"]
        },
        {
            q: "ما أهمية ثبات العطر لك؟",
            options: ["⏰ طوال اليوم - 12+ ساعة", "🕐 نصف يوم كافي", "💨 خفيف وعابر", "🔄 أجدده أكثر من مرة"]
        }
    ];

    const quizRecommendations = [
        { name: "عبدالرحمن", desc: "يناسب شخصيتك تماماً - قوي وأصيل", id: 1 },
        { name: "الليل العربي", desc: "عطر يعبر عن جاذبيتك الشرقية", id: 7 },
        { name: "الماس", desc: "لأناقتك الاستثنائية", id: 3 },
        { name: "فولكانو", desc: "لشخصيتك الجريئة", id: 5 }
    ];

    let quizStep = 0;
    let quizAnswers = [];

    function openQuiz() {
        quizStep = 0;
        quizAnswers = [];
        document.getElementById('quiz-modal').classList.remove('hidden');
        renderQuizStep();
    }

    function closeQuiz() {
        document.getElementById('quiz-modal').classList.add('hidden');
    }

    function renderQuizStep() {
        const q = quizQuestions[quizStep];
        const content = document.getElementById('quiz-content');
        const dots = document.querySelectorAll('.quiz-dot');
        dots.forEach((d, i) => {
            d.classList.toggle('bg-gold', i === quizStep);
            d.classList.toggle('w-4', i === quizStep);
            d.classList.toggle('bg-luxury-border', i !== quizStep);
        });

        content.innerHTML = `
            <p class="text-white font-bold text-center mb-5 text-lg">${q.q}</p>
            <div class="grid grid-cols-2 gap-3">
                ${q.options.map((opt, i) => `
                    <button class="quiz-option luxury-card border border-luxury-border rounded-xl p-3 text-sm text-gray-300 hover:border-gold hover:text-gold transition-all text-right ${quizAnswers[quizStep] === i ? 'border-gold text-gold bg-gold bg-opacity-10' : ''}"
                        onclick="selectQuizOption(${i}, this)">${opt}</button>
                `).join('')}
            </div>
        `;
        document.getElementById('quiz-prev').classList.toggle('hidden', quizStep === 0);
        document.getElementById('quiz-next').textContent = quizStep === quizQuestions.length - 1 ? '🎁 عرض نتيجتي' : 'التالي →';
    }

    function selectQuizOption(i, btn) {
        document.querySelectorAll('.quiz-option').forEach(b => {
            b.classList.remove('border-gold', 'text-gold', 'bg-gold', 'bg-opacity-10');
        });
        btn.classList.add('border-gold', 'text-gold', 'bg-gold', 'bg-opacity-10');
        quizAnswers[quizStep] = i;
    }

    function quizNext() {
        if (quizStep < quizQuestions.length - 1) {
            quizStep++;
            renderQuizStep();
        } else {
            showQuizResult();
        }
    }

    function quizPrev() {
        if (quizStep > 0) { quizStep--; renderQuizStep(); }
    }

    function showQuizResult() {
        const rec = quizRecommendations[Math.floor(Math.random() * quizRecommendations.length)];
        document.getElementById('quiz-content').innerHTML = `
            <div class="text-center">
                <div class="text-5xl mb-3">🌟</div>
                <h4 class="text-gold text-xl font-black mb-2">عطرك المثالي هو:</h4>
                <h3 class="text-white text-3xl font-black mb-2">${rec.name}</h3>
                <p class="text-gray-400 text-sm mb-6">${rec.desc}</p>
                <a href="/Product/Detail/${rec.id}" class="btn-gold px-8 py-3 rounded-xl font-bold block">
                    اكتشف العطر ←
                </a>
            </div>
        `;
        document.getElementById('quiz-next').classList.add('hidden');
        document.getElementById('quiz-prev').classList.add('hidden');
    }
</script>
}
