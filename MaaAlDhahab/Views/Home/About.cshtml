@{
    ViewData["Title"] = "عن ماء الذهب";
}

<!-- About Hero -->
<section class="relative py-32 bg-luxury-black overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-luxury-card to-luxury-black opacity-80"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gold opacity-5 rounded-full blur-3xl"></div>
    <div class="relative z-10 text-center max-w-4xl mx-auto px-4">
        <p class="text-gold tracking-widest text-sm uppercase mb-4 ar-text">حكاية العطر والذهب</p>
        <h1 class="text-5xl md:text-6xl font-black text-white mb-6 ar-text">عن علامة <span class="gold-gradient">ماء الذهب</span></h1>
        <p class="text-gray-300 text-lg leading-relaxed ar-text">
            "مع عطور ماء الذهب الكويتية، ستكون دائماً مميزاً، ستكون دائماً الأروع"
        </p>
    </div>
</section>

<!-- Perfumer Story -->
<section class="py-20 bg-luxury-section">
    <div class="max-w-6xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div>
                <p class="text-gold text-sm tracking-widest uppercase mb-4">المؤسس والعطار</p>
                <h2 class="text-4xl font-black text-white mb-6">عبدالرحمن أبو الذهب</h2>
                <div class="w-16 h-1 bg-gold mb-8"></div>
                <div class="space-y-5 text-gray-300 leading-relaxed">
                    <p>عبدالرحمن أبو الذهب — اسم يُلفظ بإجلال في عالم العطور. وُلد في مصر، في كنف أسرة تتوارث مهنة العطارة جيلاً بعد جيل، فاستقطر من هذا الإرث العريق سرّ مزج الروائح وتناغمها.</p>
                    <p>درس أسرار العطور في أكاديميات فرنسا الشهيرة، وجمع بين العلم الحديث والحكمة الشرقية القديمة. في الكويت، وجد المكان الذي يليق بطموحاته: أرض تعشق الفخامة وتقدّر الأصالة.</p>
                    <p>فأسّس "ماء الذهب" — علامة تحمل اسمه وشرفه — لتصبح اليوم وجهة كل من يريد عطراً يحكي قصته ويعبّر عن شخصيته بصدق وتميّز.</p>
                </div>
                <div class="grid grid-cols-3 gap-4 mt-10">
                    <div class="text-center luxury-card rounded-xl p-4">
                        <div class="text-3xl font-black text-gold">+20</div>
                        <div class="text-xs text-gray-400 mt-1">سنة خبرة</div>
                    </div>
                    <div class="text-center luxury-card rounded-xl p-4">
                        <div class="text-3xl font-black text-gold">+50</div>
                        <div class="text-xs text-gray-400 mt-1">تركيبة فريدة</div>
                    </div>
                    <div class="text-center luxury-card rounded-xl p-4">
                        <div class="text-3xl font-black text-gold">4</div>
                        <div class="text-xs text-gray-400 mt-1">فروع الكويت</div>
                    </div>
                </div>
            </div>
            <div class="flex justify-center">
                <div class="w-80 h-80 relative">
                    <div class="absolute inset-0 border-2 border-gold border-opacity-20 rounded-2xl transform rotate-6"></div>
                    <div class="absolute inset-0 bg-luxury-card rounded-2xl border border-luxury-border flex items-center justify-center">
                        <svg viewBox="0 0 200 250" class="w-48" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="100" cy="70" r="40" fill="#D4AF37" opacity="0.7"/>
                            <path d="M40 240 C40 160 160 160 160 240" fill="#D4AF37" opacity="0.5"/>
                            <text x="100" y="220" text-anchor="middle" fill="#D4AF37" font-size="11" font-family="Cairo" font-weight="bold">عبدالرحمن أبو الذهب</text>
                            <!-- Decorative elements -->
                            <path d="M80 90 L120 90 L130 130 L100 150 L70 130 Z" fill="none" stroke="#D4AF37" stroke-width="1" opacity="0.4"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values -->
<section class="py-20 bg-luxury-black">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-4xl font-black text-white ar-text">قيمنا ومبادئنا</h2>
            <div class="w-24 h-0.5 bg-gold mx-auto mt-4"></div>
        </div>
        <div class="grid md:grid-cols-4 gap-6">
            <div class="text-center luxury-card rounded-2xl p-8">
                <i class="fas fa-gem text-4xl text-gold mb-4"></i>
                <h3 class="text-white font-bold text-lg mb-2 ar-text">الجودة الفائقة</h3>
                <p class="text-gray-400 text-sm ar-text">نختار فقط أرقى المكونات من أفضل مصادر العالم</p>
            </div>
            <div class="text-center luxury-card rounded-2xl p-8">
                <i class="fas fa-leaf text-4xl text-gold mb-4"></i>
                <h3 class="text-white font-bold text-lg mb-2 ar-text">المكونات الطبيعية</h3>
                <p class="text-gray-400 text-sm ar-text">نؤمن بقوة الطبيعة في إبداع روائح لا تُنسى</p>
            </div>
            <div class="text-center luxury-card rounded-2xl p-8">
                <i class="fas fa-fingerprint text-4xl text-gold mb-4"></i>
                <h3 class="text-white font-bold text-lg mb-2 ar-text">التميّز الفريد</h3>
                <p class="text-gray-400 text-sm ar-text">كل عطر إبداع لا يتكرر، مصمم ليكون بصمتك</p>
            </div>
            <div class="text-center luxury-card rounded-2xl p-8">
                <i class="fas fa-heart text-4xl text-gold mb-4"></i>
                <h3 class="text-white font-bold text-lg mb-2 ar-text">الشغف الحقيقي</h3>
                <p class="text-gray-400 text-sm ar-text">صنعنا بحب ليصل إليك بحب</p>
            </div>
        </div>
    </div>
</section>

<!-- Branches in Kuwait -->
<section class="py-20 bg-luxury-section">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
            <p class="text-gold text-sm tracking-widest uppercase mb-2">زورونا</p>
            <h2 class="text-4xl font-black text-white ar-text">فروعنا في الكويت</h2>
            <div class="w-24 h-0.5 bg-gold mx-auto mt-4"></div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            @{
                var branches = new[]
                {
                    new { area = "الحولي", address = "شارع تونس، بجوار السوق المركزي", phone = "+965 2200 1111", hours = "9ص - 11م" },
                    new { area = "الفروانية", address = "المنطقة التجارية، برج الفروانية", phone = "+965 2200 2222", hours = "9ص - 11م" },
                    new { area = "السالمية", address = "الرياض مول، الدور الأول", phone = "+965 2200 3333", hours = "10ص - 12م" },
                    new { area = "المنقف", address = "مجمع المنقف التجاري", phone = "+965 2200 4444", hours = "9ص - 10م" }
                };
            }
            @foreach (var branch in branches)
            {
                <div class="luxury-card rounded-2xl p-6 hover:border-gold transition-colors">
                    <div class="w-12 h-12 bg-gold bg-opacity-10 border border-gold-dark rounded-full flex items-center justify-center mb-4">
                        <i class="fas fa-map-marker-alt text-gold text-xl"></i>
                    </div>
                    <h3 class="text-white font-bold text-lg mb-2">@branch.area</h3>
                    <p class="text-gray-400 text-sm mb-3">@branch.address</p>
                    <div class="flex items-center gap-2 text-gray-500 text-xs mb-1">
                        <i class="fas fa-phone text-gold"></i>
                        <span dir="ltr">@branch.phone</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-500 text-xs">
                        <i class="fas fa-clock text-gold"></i>
                        <span>@branch.hours</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
