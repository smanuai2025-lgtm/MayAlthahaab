@{
    ViewData["Title"] = "تواصل معنا";
}

<section class="py-32 bg-luxury-black">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16">
            <p class="text-gold text-sm tracking-widest uppercase mb-4">تواصل معنا</p>
            <h1 class="text-5xl font-black text-white ar-text">نحن هنا من <span class="gold-gradient">أجلك</span></h1>
            <div class="w-24 h-0.5 bg-gold mx-auto mt-4"></div>
        </div>

        <div class="grid lg:grid-cols-2 gap-16">
            <!-- Contact Form -->
            <div class="luxury-card rounded-2xl p-8 border border-luxury-border">
                <h2 class="text-2xl font-bold text-white mb-6 ar-text">أرسل لنا رسالة</h2>
                <form class="space-y-4" onsubmit="submitContact(event)">
                    <div>
                        <label class="text-gray-400 text-sm block mb-1 ar-text">الاسم</label>
                        <input type="text" class="w-full" placeholder="اسمك الكريم" />
                    </div>
                    <div>
                        <label class="text-gray-400 text-sm block mb-1 ar-text">البريد الإلكتروني</label>
                        <input type="email" dir="ltr" class="w-full" placeholder="email@example.com" />
                    </div>
                    <div>
                        <label class="text-gray-400 text-sm block mb-1 ar-text">رقم الهاتف</label>
                        <input type="tel" dir="ltr" class="w-full" placeholder="+965 xxxx xxxx" />
                    </div>
                    <div>
                        <label class="text-gray-400 text-sm block mb-1 ar-text">رسالتك</label>
                        <textarea rows="4" class="w-full" placeholder="كيف يمكننا مساعدتك؟"></textarea>
                    </div>
                    <button type="submit" class="btn-gold w-full py-4 rounded-xl font-bold text-lg">
                        <i class="fas fa-paper-plane ml-2"></i>
                        <span class="ar-text">إرسال الرسالة</span>
                    </button>
                </form>
            </div>

            <!-- Contact Info -->
            <div class="space-y-6">
                <div class="luxury-card rounded-2xl p-6 border border-luxury-border flex gap-4">
                    <div class="w-14 h-14 bg-gold bg-opacity-10 border border-gold-dark rounded-xl flex items-center justify-center flex-shrink-0">
                        <i class="fab fa-whatsapp text-gold text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-bold ar-text">واتساب</h3>
                        <p class="text-gray-400 text-sm ar-text">متاح 9ص - 11م كل يوم</p>
                        <a href="https://wa.me/96512345678" class="text-gold font-bold mt-1 block" dir="ltr">+965 1234 5678</a>
                    </div>
                </div>
                <div class="luxury-card rounded-2xl p-6 border border-luxury-border flex gap-4">
                    <div class="w-14 h-14 bg-gold bg-opacity-10 border border-gold-dark rounded-xl flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-envelope text-gold text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-bold ar-text">البريد الإلكتروني</h3>
                        <p class="text-gray-400 text-sm ar-text">رد خلال 24 ساعة</p>
                        <a href="mailto:info@maaAldhahab.com" class="text-gold font-bold mt-1 block" dir="ltr">info@maaAldhahab.com</a>
                    </div>
                </div>
                <div class="luxury-card rounded-2xl p-6 border border-luxury-border flex gap-4">
                    <div class="w-14 h-14 bg-gold bg-opacity-10 border border-gold-dark rounded-xl flex items-center justify-center flex-shrink-0">
                        <i class="fab fa-instagram text-gold text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-bold">Instagram</h3>
                        <p class="text-gray-400 text-sm ar-text">تابعنا لأحدث العروض</p>
                        <a href="#" class="text-gold font-bold mt-1 block" dir="ltr">@@maaAlDhahab</a>
                    </div>
                </div>
                <div class="luxury-card rounded-2xl p-6 border border-luxury-border">
                    <h3 class="text-white font-bold mb-4 ar-text">ساعات العمل</h3>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-400 ar-text">السبت - الخميس</span>
                            <span class="text-gold">9:00ص - 11:00م</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-400 ar-text">الجمعة</span>
                            <span class="text-gold">4:00م - 11:00م</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
function submitContact(e) {
    e.preventDefault();
    showToast('تم إرسال رسالتك بنجاح! سنتواصل معك قريباً 💌');
}
</script>
}
