<!DOCTYPE html>
<html lang="ar" dir="rtl" id="html-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#D4AF37" />
    <meta name="description" content="ماء الذهب - عطور كويتية فاخرة من إبداع عبدالرحمن أبو الذهب" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "ماء الذهب") | Maa Al Dhahab Perfumes" />
    <meta property="og:description" content="عطور فاخرة كويتية تحمل إرث عبدالرحمن أبو الذهب" />
    <meta property="og:image" content="/images/og-image.jpg" />
    <title>@(ViewData["Title"] ?? "ماء الذهب") | Maa Al Dhahab</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: {
                            DEFAULT: '#D4AF37',
                            light: '#E8C84A',
                            dark: '#B8960A',
                            pale: '#F5E6B2'
                        },
                        luxury: {
                            black: '#0A0A0A',
                            card: '#121212',
                            section: '#1A1A1A',
                            border: '#2A2A2A',
                            hover: '#222222'
                        }
                    },
                    fontFamily: {
                        arabic: ['Noto Sans Arabic', 'Cairo', 'Arial', 'sans-serif'],
                    },
                    animation: {
                        'gold-pulse': 'goldPulse 2s ease-in-out infinite',
                        'float': 'float 3s ease-in-out infinite',
                        'shimmer': 'shimmer 2s linear infinite',
                    },
                    keyframes: {
                        goldPulse: {
                            '0%, 100%': { boxShadow: '0 0 5px rgba(212, 175, 55, 0.3)' },
                            '50%': { boxShadow: '0 0 20px rgba(212, 175, 55, 0.8)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        shimmer: {
                            '0%': { backgroundPosition: '-1000px 0' },
                            '100%': { backgroundPosition: '1000px 0' },
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts - Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300;400;500;600;700;800;900&family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/luxury.css" />

    <style>
        * { font-family: 'Cairo', 'Noto Sans Arabic', Arial, sans-serif; }
        body { background-color: #0A0A0A; color: #E8E0D0; direction: rtl; }
        body.ltr { direction: ltr; }
        .gold-text { color: #D4AF37; }
        .gold-gradient { background: linear-gradient(135deg, #D4AF37 0%, #F5E6B2 50%, #C9A227 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .gold-border { border-color: #D4AF37; }
        .gold-bg { background: linear-gradient(135deg, #D4AF37, #C9A227); }
        .luxury-card { background: #121212; border: 1px solid #2A2A2A; transition: all 0.3s ease; }
        .luxury-card:hover { border-color: #D4AF37; transform: translateY(-4px); box-shadow: 0 20px 60px rgba(212, 175, 55, 0.15); }
        .gold-glow { text-shadow: 0 0 20px rgba(212, 175, 55, 0.5), 0 0 40px rgba(212, 175, 55, 0.3); }
        .particle { position: absolute; border-radius: 50%; background: radial-gradient(circle, rgba(212,175,55,0.8) 0%, transparent 70%); animation: float 3s ease-in-out infinite; pointer-events: none; }
        .nav-link-luxury { position: relative; color: #E8E0D0; transition: color 0.3s; }
        .nav-link-luxury::after { content: ''; position: absolute; bottom: -2px; right: 0; width: 0; height: 2px; background: #D4AF37; transition: width 0.3s ease; }
        .nav-link-luxury:hover { color: #D4AF37; }
        .nav-link-luxury:hover::after { width: 100%; }
        .btn-gold { background: linear-gradient(135deg, #D4AF37 0%, #C9A227 100%); color: #0A0A0A; font-weight: 700; transition: all 0.3s ease; border-radius: 4px; }
        .btn-gold:hover { background: linear-gradient(135deg, #F5E6B2 0%, #D4AF37 100%); transform: scale(1.02); box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4); }
        .btn-outline-gold { border: 1px solid #D4AF37; color: #D4AF37; background: transparent; transition: all 0.3s ease; border-radius: 4px; }
        .btn-outline-gold:hover { background: #D4AF37; color: #0A0A0A; }
        .scent-note-pill { background: rgba(212, 175, 55, 0.1); border: 1px solid rgba(212, 175, 55, 0.3); color: #D4AF37; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; display: inline-block; margin: 2px; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0A0A0A; }
        ::-webkit-scrollbar-thumb { background: #D4AF37; border-radius: 3px; }
        input, select, textarea { background: #1A1A1A !important; border-color: #2A2A2A !important; color: #E8E0D0 !important; }
        input:focus, select:focus, textarea:focus { border-color: #D4AF37 !important; outline: none !important; box-shadow: 0 0 0 2px rgba(212,175,55,0.2) !important; }
        .rating-stars { color: #D4AF37; }
        .product-img-container { overflow: hidden; position: relative; }
        .product-img-container img { transition: transform 0.5s ease; }
        .product-img-container:hover img { transform: scale(1.08); }
        @@keyframes goldShimmer { 0% { background-position: -1000px 0; } 100% { background-position: 1000px 0; } }
        .shimmer-loading { background: linear-gradient(to right, #1a1a1a 8%, #2a2a2a 18%, #1a1a1a 33%); background-size: 2000px 100%; animation: goldShimmer 2s linear infinite; }
        .hero-overlay { background: linear-gradient(135deg, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.6) 50%, rgba(10,10,10,0.85) 100%); }
        .dropdown-luxury { background: #121212; border: 1px solid #2A2A2A; box-shadow: 0 20px 60px rgba(0,0,0,0.8); }
    </style>
</head>
<body class="bg-luxury-black dark" id="app-body">

    <!-- TOP BAR -->
    <div class="bg-gold-dark text-luxury-black text-center py-1.5 text-sm font-semibold" id="topbar">
        <span class="ar-text">🎁 شحن مجاني للطلبات فوق 15 د.ك | استخدم كود: <strong>WELCOME20</strong> للحصول على خصم 20%</span>
        <span class="en-text hidden"> 🎁 Free shipping on orders above 15 KD | Use code: <strong>WELCOME20</strong> for 20% off</span>
    </div>

    <!-- NAVBAR -->
    <nav class="sticky top-0 z-50 bg-luxury-black border-b border-luxury-border backdrop-blur-md" id="main-nav">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex items-center justify-between h-16 lg:h-20">

                <!-- Logo -->
                <a href="/" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 lg:w-12 lg:h-12 flex items-center justify-center">
                        <svg viewBox="0 0 60 60" class="w-full h-full" fill="none">
                            <circle cx="30" cy="30" r="28" stroke="#D4AF37" stroke-width="1.5"/>
                            <path d="M30 8 L35 20 L48 20 L38 28 L42 42 L30 34 L18 42 L22 28 L12 20 L25 20 Z" fill="#D4AF37" opacity="0.9"/>
                            <circle cx="30" cy="30" r="4" fill="#D4AF37"/>
                        </svg>
                    </div>
                    <div class="text-right">
                        <div class="text-gold font-black text-xl lg:text-2xl leading-none ar-text">ماء الذهب</div>
                        <div class="text-gold-dark text-xs lg:text-sm tracking-widest en-text">MAA AL DHAHAB</div>
                    </div>
                </a>

                <!-- Desktop Nav -->
                <div class="hidden lg:flex items-center gap-8">
                    <a href="/" class="nav-link-luxury text-sm font-medium">
                        <span class="ar-text">الرئيسية</span><span class="en-text hidden">Home</span>
                    </a>
                    <div class="relative group">
                        <a href="/Shop" class="nav-link-luxury text-sm font-medium flex items-center gap-1">
                            <span class="ar-text">المتجر</span><span class="en-text hidden">Shop</span>
                            <i class="fas fa-chevron-down text-xs mt-0.5 transition-transform group-hover:rotate-180"></i>
                        </a>
                        <div class="absolute top-full right-0 w-48 dropdown-luxury rounded-lg p-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200">
                            <a href="/Shop?gender=Female" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm">
                                <i class="fas fa-female gold-text text-xs"></i>
                                <span class="ar-text">نسائي</span><span class="en-text hidden">Women</span>
                            </a>
                            <a href="/Shop?gender=Male" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm">
                                <i class="fas fa-male gold-text text-xs"></i>
                                <span class="ar-text">رجالي</span><span class="en-text hidden">Men</span>
                            </a>
                            <a href="/Shop?gender=Unisex" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm">
                                <i class="fas fa-infinity gold-text text-xs"></i>
                                <span class="ar-text">يونيسكس</span><span class="en-text hidden">Unisex</span>
                            </a>
                            <a href="/Shop?gender=Kids" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm">
                                <i class="fas fa-child gold-text text-xs"></i>
                                <span class="ar-text">أطفال</span><span class="en-text hidden">Kids</span>
                            </a>
                        </div>
                    </div>
                    <a href="/Home/About" class="nav-link-luxury text-sm font-medium">
                        <span class="ar-text">عن العلامة</span><span class="en-text hidden">About</span>
                    </a>
                    <a href="/Home/Contact" class="nav-link-luxury text-sm font-medium">
                        <span class="ar-text">تواصل معنا</span><span class="en-text hidden">Contact</span>
                    </a>
                </div>

                <!-- Right Actions -->
                <div class="flex items-center gap-3 lg:gap-4">
                    <!-- Search -->
                    <button onclick="toggleSearch()" class="text-gray-400 hover:text-gold transition-colors p-2">
                        <i class="fas fa-search text-lg"></i>
                    </button>

                    <!-- Language Toggle -->
                    <button onclick="toggleLanguage()" class="text-gray-400 hover:text-gold transition-colors text-sm font-medium">
                        <span id="lang-btn">EN</span>
                    </button>

                    <!-- Wishlist -->
                    <a href="#" class="text-gray-400 hover:text-gold transition-colors p-2 relative">
                        <i class="fas fa-heart text-lg"></i>
                    </a>

                    <!-- Cart -->
                    <a href="/Cart" class="relative p-2 hover:text-gold transition-colors">
                        <i class="fas fa-shopping-bag text-xl text-gold"></i>
                        <span id="cart-count" class="absolute -top-1 -left-1 bg-gold text-black text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold hidden">0</span>
                    </a>

                    <!-- User Menu -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="relative group hidden lg:block">
                            <button class="text-gray-400 hover:text-gold transition-colors p-2">
                                <i class="fas fa-user-circle text-xl"></i>
                            </button>
                            <div class="absolute top-full left-0 w-44 dropdown-luxury rounded-lg p-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200">
                                <a href="/Account/Profile" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm">
                                    <i class="fas fa-user gold-text text-xs"></i>
                                    <span class="ar-text">ملفي الشخصي</span><span class="en-text hidden">Profile</span>
                                </a>
                                <a href="/Account/OrderHistory" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm">
                                    <i class="fas fa-box gold-text text-xs"></i>
                                    <span class="ar-text">طلباتي</span><span class="en-text hidden">My Orders</span>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a href="/admin" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm">
                                        <i class="fas fa-cog gold-text text-xs"></i>
                                        <span>لوحة التحكم</span>
                                    </a>
                                }
                                <hr class="border-luxury-border my-1">
                                <form method="post" action="/Account/Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-luxury-hover text-sm w-full text-right text-red-400">
                                        <i class="fas fa-sign-out-alt text-xs"></i>
                                        <span class="ar-text">تسجيل الخروج</span><span class="en-text hidden">Logout</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="hidden lg:flex items-center gap-2 btn-gold px-4 py-2 text-sm rounded">
                            <i class="fas fa-sign-in-alt text-xs"></i>
                            <span class="ar-text">دخول</span><span class="en-text hidden">Login</span>
                        </a>
                    }

                    <!-- Mobile Menu Toggle -->
                    <button onclick="toggleMobileMenu()" class="lg:hidden text-gray-400 hover:text-gold p-2">
                        <i class="fas fa-bars text-xl" id="menu-icon"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Search Bar (slide down) -->
        <div id="search-bar" class="hidden bg-luxury-section border-t border-luxury-border">
            <div class="max-w-2xl mx-auto px-4 py-3 relative">
                <input type="text" id="search-input" placeholder="ابحث عن عطرك..." onkeyup="handleSearch(this.value)"
                    class="w-full bg-luxury-card border border-luxury-border rounded-lg px-5 py-3 text-sm focus:border-gold placeholder-gray-500" />
                <div id="search-results" class="absolute top-full left-4 right-4 dropdown-luxury rounded-lg mt-1 hidden z-50 max-h-60 overflow-y-auto"></div>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="fixed inset-0 z-40 bg-luxury-black transform translate-x-full transition-transform duration-300 lg:hidden">
        <div class="flex items-center justify-between p-4 border-b border-luxury-border">
            <span class="gold-text text-xl font-bold">ماء الذهب</span>
            <button onclick="toggleMobileMenu()" class="text-gray-400 hover:text-gold p-2">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        <nav class="p-4 space-y-1">
            <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-lg">
                <i class="fas fa-home gold-text w-6"></i>
                <span class="ar-text">الرئيسية</span><span class="en-text hidden">Home</span>
            </a>
            <a href="/Shop" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-lg">
                <i class="fas fa-store gold-text w-6"></i>
                <span class="ar-text">المتجر</span><span class="en-text hidden">Shop</span>
            </a>
            <a href="/Shop?gender=Female" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-sm pr-10">
                <i class="fas fa-female gold-text w-6"></i>
                <span class="ar-text">نسائي</span><span class="en-text hidden">Women</span>
            </a>
            <a href="/Shop?gender=Male" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-sm pr-10">
                <i class="fas fa-male gold-text w-6"></i>
                <span class="ar-text">رجالي</span><span class="en-text hidden">Men</span>
            </a>
            <a href="/Home/About" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-lg">
                <i class="fas fa-info-circle gold-text w-6"></i>
                <span class="ar-text">عن العلامة</span><span class="en-text hidden">About</span>
            </a>
            <a href="/Cart" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-lg">
                <i class="fas fa-shopping-bag gold-text w-6"></i>
                <span class="ar-text">السلة</span><span class="en-text hidden">Cart</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Account/Profile" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-lg">
                    <i class="fas fa-user gold-text w-6"></i>
                    <span class="ar-text">ملفي الشخصي</span>
                </a>
            }
            else
            {
                <a href="/Account/Login" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-luxury-hover text-lg">
                    <i class="fas fa-sign-in-alt gold-text w-6"></i>
                    <span class="ar-text">تسجيل الدخول</span>
                </a>
            }
        </nav>
        <div class="absolute bottom-8 left-0 right-0 text-center">
            <div class="flex justify-center gap-6">
                <a href="#" class="text-gray-500 hover:text-gold text-2xl"><i class="fab fa-instagram"></i></a>
                <a href="#" class="text-gray-500 hover:text-gold text-2xl"><i class="fab fa-whatsapp"></i></a>
                <a href="#" class="text-gray-500 hover:text-gold text-2xl"><i class="fab fa-snapchat"></i></a>
                <a href="#" class="text-gray-500 hover:text-gold text-2xl"><i class="fab fa-tiktok"></i></a>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="bg-luxury-card border-t border-luxury-border mt-20">
        <div class="max-w-7xl mx-auto px-4 py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

                <!-- Brand -->
                <div class="lg:col-span-1">
                    <div class="flex items-center gap-3 mb-6">
                        <svg viewBox="0 0 60 60" class="w-12 h-12" fill="none">
                            <circle cx="30" cy="30" r="28" stroke="#D4AF37" stroke-width="1.5"/>
                            <path d="M30 8 L35 20 L48 20 L38 28 L42 42 L30 34 L18 42 L22 28 L12 20 L25 20 Z" fill="#D4AF37" opacity="0.9"/>
                        </svg>
                        <div>
                            <div class="gold-text text-2xl font-black">ماء الذهب</div>
                            <div class="text-gray-500 text-xs tracking-widest">MAA AL DHAHAB</div>
                        </div>
                    </div>
                    <p class="text-gray-400 text-sm leading-relaxed ar-text">
                        عطور كويتية فاخرة من إبداع العطار المصري الشهير عبدالرحمن أبو الذهب.
                        عطرك يعبر عن شخصيتك ويحكي قصتك.
                    </p>
                    <p class="text-gray-400 text-sm leading-relaxed en-text hidden">
                        Luxury Kuwaiti perfumes crafted by the legendary Egyptian perfumer Abdul Rahman Abu Al Dhahab.
                    </p>
                    <div class="flex gap-4 mt-6">
                        <a href="#" class="w-10 h-10 bg-luxury-section border border-luxury-border rounded-full flex items-center justify-center hover:border-gold hover:text-gold transition-all">
                            <i class="fab fa-instagram text-sm"></i>
                        </a>
                        <a href="#" class="w-10 h-10 bg-luxury-section border border-luxury-border rounded-full flex items-center justify-center hover:border-gold hover:text-gold transition-all">
                            <i class="fab fa-whatsapp text-sm"></i>
                        </a>
                        <a href="#" class="w-10 h-10 bg-luxury-section border border-luxury-border rounded-full flex items-center justify-center hover:border-gold hover:text-gold transition-all">
                            <i class="fab fa-snapchat text-sm"></i>
                        </a>
                        <a href="#" class="w-10 h-10 bg-luxury-section border border-luxury-border rounded-full flex items-center justify-center hover:border-gold hover:text-gold transition-all">
                            <i class="fab fa-tiktok text-sm"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div>
                    <h3 class="text-gold font-bold text-lg mb-6 ar-text">روابط سريعة</h3>
                    <h3 class="text-gold font-bold text-lg mb-6 en-text hidden">Quick Links</h3>
                    <ul class="space-y-3">
                        <li><a href="/Shop" class="text-gray-400 hover:text-gold transition-colors text-sm ar-text">جميع العطور</a><a href="/Shop" class="text-gray-400 hover:text-gold transition-colors text-sm en-text hidden">All Perfumes</a></li>
                        <li><a href="/Shop?gender=Female" class="text-gray-400 hover:text-gold transition-colors text-sm ar-text">عطور نسائية</a><a href="/Shop?gender=Female" class="text-gray-400 hover:text-gold transition-colors text-sm en-text hidden">Women's</a></li>
                        <li><a href="/Shop?gender=Male" class="text-gray-400 hover:text-gold transition-colors text-sm ar-text">عطور رجالية</a><a href="/Shop?gender=Male" class="text-gray-400 hover:text-gold transition-colors text-sm en-text hidden">Men's</a></li>
                        <li><a href="/Home/About" class="text-gray-400 hover:text-gold transition-colors text-sm ar-text">قصتنا</a><a href="/Home/About" class="text-gray-400 hover:text-gold transition-colors text-sm en-text hidden">Our Story</a></li>
                        <li><a href="/Home/Contact" class="text-gray-400 hover:text-gold transition-colors text-sm ar-text">تواصل معنا</a><a href="/Home/Contact" class="text-gray-400 hover:text-gold transition-colors text-sm en-text hidden">Contact</a></li>
                    </ul>
                </div>

                <!-- Branches -->
                <div>
                    <h3 class="text-gold font-bold text-lg mb-6 ar-text">فروعنا في الكويت</h3>
                    <h3 class="text-gold font-bold text-lg mb-6 en-text hidden">Our Branches</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-2">
                            <i class="fas fa-map-marker-alt text-gold mt-1 text-sm flex-shrink-0"></i>
                            <span class="text-gray-400 text-sm">الحولي - شارع تونس</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-map-marker-alt text-gold mt-1 text-sm flex-shrink-0"></i>
                            <span class="text-gray-400 text-sm">الفروانية - المنطقة التجارية</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-map-marker-alt text-gold mt-1 text-sm flex-shrink-0"></i>
                            <span class="text-gray-400 text-sm">السالمية - الرياض مول</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-map-marker-alt text-gold mt-1 text-sm flex-shrink-0"></i>
                            <span class="text-gray-400 text-sm">المنقف - مجمع المنقف</span>
                        </li>
                    </ul>
                </div>

                <!-- Newsletter -->
                <div>
                    <h3 class="text-gold font-bold text-lg mb-6 ar-text">اشترك في نشرتنا</h3>
                    <h3 class="text-gold font-bold text-lg mb-6 en-text hidden">Newsletter</h3>
                    <p class="text-gray-400 text-sm mb-4 ar-text">احصل على أحدث العروض والعطور الجديدة أول بأول</p>
                    <div class="flex gap-2">
                        <input type="email" id="footer-email" placeholder="بريدك الإلكتروني..." class="flex-1 bg-luxury-section border border-luxury-border rounded-lg px-3 py-2 text-sm" />
                        <button onclick="subscribeNewsletter()" class="btn-gold px-4 py-2 rounded-lg text-sm whitespace-nowrap">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                    <p id="subscribe-msg" class="text-sm mt-2 hidden"></p>

                    <!-- Payment Methods -->
                    <div class="mt-6">
                        <p class="text-gray-500 text-xs mb-3 ar-text">طرق الدفع المقبولة:</p>
                        <div class="flex gap-3 items-center flex-wrap">
                            <span class="bg-luxury-section border border-luxury-border rounded px-2 py-1 text-xs text-gray-400">KNET</span>
                            <span class="bg-luxury-section border border-luxury-border rounded px-2 py-1 text-xs text-gray-400">Visa</span>
                            <span class="bg-luxury-section border border-luxury-border rounded px-2 py-1 text-xs text-gray-400">Mastercard</span>
                            <span class="bg-luxury-section border border-luxury-border rounded px-2 py-1 text-xs text-gray-400">نقدي</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t border-luxury-border py-6">
            <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-gray-500 text-sm ar-text">© 2025 ماء الذهب - جميع الحقوق محفوظة</p>
                <p class="text-gray-500 text-sm en-text hidden">© 2025 Maa Al Dhahab - All Rights Reserved</p>
                <div class="flex gap-6">
                    <a href="/Home/Privacy" class="text-gray-500 hover:text-gold text-sm ar-text">سياسة الخصوصية</a>
                    <a href="/Home/Terms" class="text-gray-500 hover:text-gold text-sm ar-text">الشروط والأحكام</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- PWA Install Prompt -->
    <div id="pwa-install-banner" class="fixed bottom-20 left-4 right-4 md:left-auto md:right-4 md:w-96 bg-luxury-card border border-gold rounded-xl p-4 shadow-2xl z-50 hidden">
        <div class="flex items-start gap-3">
            <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0">
                <svg viewBox="0 0 60 60" class="w-full h-full bg-luxury-black p-1" fill="none">
                    <circle cx="30" cy="30" r="28" stroke="#D4AF37" stroke-width="2"/>
                    <path d="M30 8 L35 20 L48 20 L38 28 L42 42 L30 34 L18 42 L22 28 L12 20 L25 20 Z" fill="#D4AF37"/>
                </svg>
            </div>
            <div class="flex-1">
                <p class="font-bold text-sm ar-text">ثبّت تطبيق ماء الذهب</p>
                <p class="text-gray-400 text-xs mt-1 ar-text">تجربة أفضل وأسرع وتصفح بدون انترنت!</p>
                <div class="flex gap-2 mt-3">
                    <button onclick="installPWA()" class="btn-gold px-4 py-1.5 rounded text-xs font-bold ar-text">تثبيت</button>
                    <button onclick="dismissPWA()" class="btn-outline-gold px-4 py-1.5 rounded text-xs ar-text">لاحقاً</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-4 right-4 z-50 hidden">
        <div class="bg-luxury-card border border-gold rounded-xl px-6 py-4 shadow-2xl flex items-center gap-3 max-w-sm">
            <i class="fas fa-check-circle text-gold text-xl" id="toast-icon"></i>
            <p id="toast-msg" class="text-sm font-medium"></p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/js/app.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/pwa.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
