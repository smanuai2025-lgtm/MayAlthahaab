@model Order
@{
    ViewData["Title"] = "تم الطلب بنجاح";
}

<div class="max-w-3xl mx-auto px-4 py-20 text-center">
    <!-- Success Animation -->
    <div class="w-24 h-24 bg-gold bg-opacity-20 border-2 border-gold rounded-full flex items-center justify-center mx-auto mb-8 animate-gold-pulse">
        <i class="fas fa-check text-gold text-4xl"></i>
    </div>

    <h1 class="text-4xl font-black text-white mb-3 ar-text">تم تأكيد طلبك! 🎉</h1>
    <p class="text-gray-300 text-lg mb-2 ar-text">شكراً لك <strong class="text-gold">@Model.CustomerName</strong></p>
    <p class="text-gray-400 mb-8 ar-text">
        رقم طلبك هو: <span class="text-gold font-black text-xl">@Model.OrderNumber</span>
    </p>

    <!-- Order Details Card -->
    <div class="luxury-card rounded-2xl p-8 border border-luxury-border text-right mb-8">
        <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div>
                <h3 class="text-gold font-bold mb-3 ar-text">معلومات التوصيل</h3>
                <p class="text-white font-bold ar-text">@Model.CustomerName</p>
                <p class="text-gray-400 text-sm ar-text">@Model.Governorate، @Model.Area</p>
                <p class="text-gray-400 text-sm ar-text">القطعة @Model.Block، شارع @Model.Street</p>
                <p class="text-gray-400 text-sm ar-text">@Model.HouseNumber</p>
            </div>
            <div>
                <h3 class="text-gold font-bold mb-3 ar-text">تفاصيل الطلب</h3>
                <div class="space-y-1 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-400 ar-text">طريقة الدفع</span>
                        <span class="text-white">@Model.PaymentMethod</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 ar-text">حالة الطلب</span>
                        <span class="text-yellow-400 font-bold ar-text">@Model.OrderStatus</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 ar-text">المجموع</span>
                        <span class="text-gold font-black text-lg">@Model.Total.ToString("F3") KD</span>
                    </div>
                </div>
            </div>
        </div>

        <hr class="border-luxury-border mb-6" />

        <!-- Order Items -->
        <h3 class="text-gold font-bold mb-4 ar-text">المنتجات المطلوبة</h3>
        <div class="space-y-3">
            @foreach (var item in Model.OrderItems)
            {
                <div class="flex items-center justify-between py-2 border-b border-luxury-border last:border-none">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-luxury-section rounded-lg overflow-hidden">
                            <img src="@(item.Product?.ImageUrl ?? "/images/product-placeholder.svg")" class="w-full h-full object-cover"
                                 onerror="this.src='/images/product-placeholder.svg'" />
                        </div>
                        <div>
                            <p class="text-white font-bold text-sm ar-text">@item.ProductName</p>
                            <p class="text-gray-500 text-xs">@item.Size × @item.Quantity</p>
                        </div>
                    </div>
                    <span class="text-gold font-bold">@item.Total.ToString("F3") KD</span>
                </div>
            }
        </div>
    </div>

    <!-- Estimated Delivery -->
    <div class="p-5 bg-gold bg-opacity-10 border border-gold border-opacity-30 rounded-2xl mb-8">
        <i class="fas fa-truck text-gold text-2xl mb-2"></i>
        <p class="text-white font-bold ar-text">الموعد المتوقع للتوصيل</p>
        <p class="text-gold font-black text-xl ar-text">خلال 24-48 ساعة</p>
        <p class="text-gray-400 text-sm mt-1 ar-text">سنتواصل معك على @Model.CustomerPhone لتأكيد موعد التسليم</p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/Shop" class="btn-gold px-10 py-4 rounded-xl font-bold text-lg">
            <span class="ar-text">متابعة التسوق</span>
        </a>
        <a href="https://wa.me/96512345678?text=طلب رقم: @Model.OrderNumber" target="_blank"
           class="flex items-center justify-center gap-2 bg-green-700 hover:bg-green-600 text-white px-10 py-4 rounded-xl font-bold transition-colors">
            <i class="fab fa-whatsapp text-xl"></i>
            <span class="ar-text">تواصل معنا</span>
        </a>
    </div>
</div>
